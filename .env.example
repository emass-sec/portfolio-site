# Copy to .env.local for local dev. In production set these as
# build variables in Workers Builds (Worker > Settings > Build).
# Public Turnstile site key; this one is Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional. Full site URL for canonical and Open Graph tags.
VITE_SITE_URL=
